#!/bin/bash

BOLD=$(tput bold)
NORMAL=$(tput sgr0)
BLUE=$(tput setaf 4)
RED=$(tput setaf 1)
GREEN=$(tput setaf 2)

echo "${BLUE}Running CI checks...${NORMAL}"

# Capture CI output and exit status (use non-interactive CI target)
CI_OUTPUT=$(make -C backend ci 2>&1)
CI_EXIT_CODE=$?

echo
echo "$CI_OUTPUT"
echo

if [ $CI_EXIT_CODE -ne 0 ]; then
  echo "${RED}❌ CI inspection failed${NORMAL}"
  echo
  echo "${BOLD}CI errors:${NORMAL}"
  echo
  echo "Please fix the issues before committing."
  echo "For linter issues you can run '${BOLD}make -C backend lint-fix${NORMAL}' to automatically fix some issues."

  exit 1
else
  echo "${GREEN}✓ CI inspection successful${NORMAL}"
fi
